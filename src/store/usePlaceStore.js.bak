import { create } from 'zustand'
import { placesAPI, favoritesAPI } from '../services/api'

const usePlaceStore = create((set, get) => ({
  places: [],
  favorites: [],
  isLoading: false,
  error: null,

  fetchPlaces: async (params = {}) => {
    set({ isLoading: true, error: null })
    try {
      const response = await placesAPI.getAll(params)
      const places = response.data || response || []
      set({ places, isLoading: false })
      return places
    } catch (error) {
      set({ error: error.message, isLoading: false })
      return []
    }
  },

  fetchFavorites: async () => {
    try {
      const response = await favoritesAPI.getAll()
      const favorites = response.data || response || []
      set({ favorites })
      return favorites
    } catch (error) {
      console.error('Failed to fetch favorites:', error)
      return []
    }
  },

  addFavorite: async (placeId) => {
    try {
      await favoritesAPI.add(placeId)
      await get().fetchFavorites()
      return true
    } catch (error) {
      console.error('Failed to add favorite:', error)
      return false
    }
  },

  removeFavorite: async (placeId) => {
    try {
      await favoritesAPI.remove(placeId)
      set(state => ({ favorites: state.favorites.filter(f => f.id !== placeId) }))
      return true
    } catch (error) {
      console.error('Failed to remove favorite:', error)
      return false
    }
  },

  isFavorite: (placeId) => {
    return get().favorites.some(f => f.id === placeId)
  },
}))

export default usePlaceStore
